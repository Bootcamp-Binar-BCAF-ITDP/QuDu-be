# Copy to .env on the server and fill in. .env is gitignored and must stay that
# way: it is the only place the real secrets live.
#
#   cp .env.example .env && chmod 600 .env

# ---- database ----
DB_URL=jdbc:postgresql://db:5432/qudu2
DB_USERNAME=qudu
DB_PASSWORD=

POSTGRES_DB=qudu2
POSTGRES_USER=qudu
POSTGRES_PASSWORD=

# ---- security ----
JWT_SECRET=
JWT_TTL_MINUTES=15
REFRESH_TTL_DAYS=7

# Exact browser origin of the frontend, no trailing slash.
# e.g. http://18.142.139.120 or https://app.example.com
CORS_ALLOWED_ORIGIN=

# ---- mail ----
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

FRONTEND_RESET_PASSWORD_URL=http://localhost:4200/reset-password/{token}

# ---- api documentation ----
# Swagger UI at /swagger-ui.html. Set false once the port faces the public
# internet: it publishes the shape of every endpoint.
API_DOCS_ENABLED=true

# ---- push notifications ----
FIREBASE_ENABLED=false
FIREBASE_CREDENTIALS_PATH=/app/secrets/firebase-credentials.json
