# Copy to .env on the server and fill in. .env is gitignored and must stay that
# way: it is the only place the real secrets live.
#
#   cp .env.example .env && chmod 600 .env
#
# This compose file runs the backend only. PostgreSQL is not part of it, so
# DB_URL must point at a database that already exists and is reachable from the
# container.

# ---- image and port ----
# APP_IMAGE=ghcr.io/bootcamp-binar-bcaf-itdp/qudu-be:latest
APP_PORT=8080

# ---- database ----
# On the same VM, outside Docker: use the docker0 gateway, not localhost.
#   jdbc:postgresql://172.17.0.1:5432/qudu2
# Cloud SQL or another host: use its address.
DB_URL=jdbc:postgresql://172.17.0.1:5432/qudu2
DB_USERNAME=
DB_PASSWORD=

# ---- security ----
JWT_SECRET=
JWT_TTL_MINUTES=30
REFRESH_TTL_DAYS=7

# Exact browser origin of the frontend, no trailing slash.
CORS_ALLOWED_ORIGIN=https://quick-duit.profilku.site

# ---- mail ----
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# {token} must be a path segment, not a query parameter.
FRONTEND_RESET_PASSWORD_URL=https://quick-duit.profilku.site/reset-password/{token}

# ---- api documentation ----
# Swagger UI at /swagger-ui.html. Set false once the port faces the internet.
API_DOCS_ENABLED=true

# ---- push notifications ----
# Put the service-account JSON at ./secrets/firebase-credentials.json on the
# host; compose mounts ./secrets read-only at /app/secrets.
FIREBASE_ENABLED=false
FIREBASE_CREDENTIALS_PATH=file:/app/secrets/firebase-credentials.json

# ---- uploads ----
# Left at the image default (/app/uploads), which compose backs with the named
# volume "uploads" so documents survive a redeploy.
