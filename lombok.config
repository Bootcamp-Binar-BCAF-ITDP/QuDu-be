# Stops Lombok looking for more config files further up the directory tree.
config.stopBubbling = true

# Marks everything Lombok generates with @lombok.Generated, which JaCoCo knows
# to skip.
#
# Without this the coverage figure is meaningless here. Nearly every class in
# this project carries @Getter, @Setter, @Builder or @RequiredArgsConstructor,
# so the bytecode is mostly generated accessors. They would all count as
# untested code that nobody wrote and nobody should write a test for, and the
# real number would be buried under them.
lombok.addLombokGeneratedAnnotation = true
